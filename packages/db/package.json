{
  "name": "@thesis-research-os/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./migrator": {
      "types": "./dist/migrator.d.ts",
      "import": "./dist/migrator.js",
      "default": "./dist/migrator.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.json --moduleResolution node16 --module node16",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json --moduleResolution node16 --module node16",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/migrator.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "@libsql/client": "^0.15.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
