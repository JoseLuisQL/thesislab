{
  "name": "@thesis-research-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "lint": "tsc --noEmit -p tsconfig.json --moduleResolution node16 --module node16",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json --moduleResolution node16 --module node16"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "zod": "^3.24.2",
    "@thesis-research-os/shared": "workspace:*",
    "@thesis-research-os/runtime": "workspace:*",
    "@thesis-research-os/db": "workspace:*",
    "@thesis-research-os/thesis-registry": "workspace:*",
    "@thesis-research-os/memory-system": "workspace:*",
    "@thesis-research-os/intake-engine": "workspace:*",
    "@thesis-research-os/latex-engine": "workspace:*",
    "@thesis-research-os/research-engine": "workspace:*",
    "@thesis-research-os/pdf-evidence-extractor": "workspace:*",
    "@thesis-research-os/zotero-bridge": "workspace:*",
    "@thesis-research-os/university-policy-engine": "workspace:*",
    "@thesis-research-os/academic-qa": "workspace:*",
    "@thesis-research-os/workflow-orchestrator": "workspace:*",
    "@thesis-research-os/evidence-graph": "workspace:*",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
